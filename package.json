{
  "name": "kannawa-wellness",
  "private": true,
  "version": "1.0.0",
  "description": "Build and standalone packaging workflow for Kannawa Wellness site",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:site": "vite build",
    "package:standalone": "node ./scripts/build-standalone.mjs",
    "zip:standalone": "cd dist && zip -r ../kannawa-wellness-standalone.zip standalone",
    "build": "npm run build:site && npm run package:standalone",
    "build:zip": "npm run build && npm run zip:standalone",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
